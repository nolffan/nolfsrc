# Every text file in this tree uses LF line endings, except these two: they
# are embedded byte for byte in CRes.dll (TEXT resources CREDITS and INTRO,
# read by the game at run time) and keep the CRLF endings they shipped with.
src/game/ClientRes/credits.txt -text
src/game/ClientRes/intro.txt -text
# The modern build's changed retail files (build/moderndata.py): game data,
# kept byte for byte (CRLF text, binary textures and models).
assets/modern/rez/** -text -diff
assets/modern/gamedir/** -text
# The retail art our binaries are compiled with (assets/art/,
# build/retailextract.py art): kept byte for byte (goty.rc and credits.txt
# have CRLF line endings).
assets/art/** -text -diff
