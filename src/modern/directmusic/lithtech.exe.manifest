  </file>
  <file name="ms_dmscript.dll">
    <comClass clsid="{1CEBDE3E-6B91-484A-AF48-5E4F4ED6B1E1}" threadingModel="Both" description="DirectMusic Script AutoImp AudioPathConfig"/>
    <comClass clsid="{2C5F9B72-7148-4D97-BFC9-68A0E076BEBD}" threadingModel="Both" description="DirectMusic Script AutoImp AudioPath"/>
    <comClass clsid="{4062C116-0270-11D3-8BCB-00600893B1B6}" threadingModel="Both" description="DirectMusic Script AutoImp Segment"/>
