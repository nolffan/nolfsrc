  </file>
  <file name="ms_dmstyle.dll">
    <comClass clsid="{3F037241-414E-11D1-A7CE-00A0C913F73C}" threadingModel="Both" description="DirectMusicSection"/>
    <comClass clsid="{B0684266-B57F-11D2-97F9-00C04FA36E58}" threadingModel="Both" description="DirectMusicMelodyFormulationTrack"/>
    <comClass clsid="{D2AC288A-B39B-11D1-8704-00600893B1BD}" threadingModel="Both" description="DirectMusicStyle"/>
    <comClass clsid="{D2AC288B-B39B-11D1-8704-00600893B1BD}" threadingModel="Both" description="DirectMusicChordTrack"/>
    <comClass clsid="{D2AC288C-B39B-11D1-8704-00600893B1BD}" threadingModel="Both" description="DirectMusicCommandTrack"/>
    <comClass clsid="{D2AC288D-B39B-11D1-8704-00600893B1BD}" threadingModel="Both" description="DirectMusicStyleTrack"/>
    <comClass clsid="{D2AC288E-B39B-11D1-8704-00600893B1BD}" threadingModel="Both" description="DirectMusicMotifTrack"/>
    <comClass clsid="{D2AC2897-B39B-11D1-8704-00600893B1BD}" threadingModel="Both" description="DirectMusicAuditionTrack"/>
    <comClass clsid="{D2AC2898-B39B-11D1-8704-00600893B1BD}" threadingModel="Both" description="DirectMusicMuteTrack"/>
  </file>
  <file name="ms_dmsynth.dll">
