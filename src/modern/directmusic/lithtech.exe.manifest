    <comClass clsid="{55A8FD00-4288-11D3-9BD1-8A0D61C88835}" threadingModel="Both" description="DirectMusicMarkerTrack"/>
    <comClass clsid="{995C1CF5-54FF-11D3-8BDA-00600893B1B6}" threadingModel="Both" description="DirectMusicLyricsTrack"/>
    <comClass clsid="{AED5F0A5-D972-483D-A384-649DFEB9C181}" threadingModel="Both" description="DirectMusicSong"/>
    <comClass clsid="{BAE4D665-4EA1-11D3-8BDA-00600893B1B6}" threadingModel="Both" description="DirectMusicSegTriggerTrack"/>
    <comClass clsid="{D2AC2881-B39B-11D1-8704-00600893B1BD}" threadingModel="Both" description="DirectMusicPerformance"/>
    <comClass clsid="{D2AC2882-B39B-11D1-8704-00600893B1BD}" threadingModel="Both" description="DirectMusicSegment"/>
    <comClass clsid="{D2AC2883-B39B-11D1-8704-00600893B1BD}" threadingModel="Both" description="DirectMusicSegmentState"/>
