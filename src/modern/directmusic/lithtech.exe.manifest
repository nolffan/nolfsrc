  </file>
  <file name="ms_dmusic.dll">
    <comClass clsid="{480FF4B0-28B2-11D1-BEF7-00C04FBF8FEF}" threadingModel="Both" description="DirectMusicCollection"/>
    <comClass clsid="{636B9F10-0C7D-11D1-95B2-0020AFDC7421}" threadingModel="Both" description="DirectMusic"/>
  </file>
  <file name="ms_dswave.dll">
    <comClass clsid="{8A667154-F9CB-11D2-AD8A-0060B0575ABC}" threadingModel="Both" description="Microsoft DirectSound Wave"/>
  </file>
  <!-- M-P3-23: DPI-aware, so with Windows' display scaling the game is
       drawn at the screen's own pixels, not stretched from a smaller
       virtual screen (and its modes are the screen's real ones). -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>
</assembly>
