<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  lithtech.exe.manifest: the modern build's DirectMusic, from the game
  directory (src/modern/directmusic/README.md). Every COM class Microsoft's
  DirectMusic DLLs register, as their own DllRegisterServer writes them,
  mapped to the copies the build installs beside lithtech.exe as
  ms_<name>.dll. The names are not Wine's, so Wine loads Microsoft's code
  rather than its own builtin of the same name.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="NOLF.lithtech" version="1.0.0.0" processorArchitecture="x86"/>
  <file name="ms_dmband.dll">
    <comClass clsid="{79BA9E00-B6EE-11D1-86BE-00C04FBF8FEF}" threadingModel="Both" description="DirectMusicBand"/>
    <comClass clsid="{D2AC2894-B39B-11D1-8704-00600893B1BD}" threadingModel="Both" description="DirectMusicBandTrack"/>
  </file>
  <file name="ms_dmcompos.dll">
    <comClass clsid="{D2AC288F-B39B-11D1-8704-00600893B1BD}" threadingModel="Both" description="DirectMusicChordMap"/>
    <comClass clsid="{D2AC2890-B39B-11D1-8704-00600893B1BD}" threadingModel="Both" description="DirectMusicComposer"/>
    <comClass clsid="{D2AC2896-B39B-11D1-8704-00600893B1BD}" threadingModel="Both" description="DirectMusicChordMapTrack"/>
    <comClass clsid="{D30BCC65-60E8-11D1-A7CE-00A0C913F73C}" threadingModel="Both" description="DirectMusicTemplate"/>
    <comClass clsid="{F17E8672-C3B4-11D1-870B-00600893B1BD}" threadingModel="Both" description="DirectMusicSignPostTrack"/>
  </file>
  <file name="ms_dmime.dll">
