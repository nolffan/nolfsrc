    <comClass clsid="{D2AC2885-B39B-11D1-8704-00600893B1BD}" threadingModel="Both" description="DirectMusicTempoTrack"/>
    <comClass clsid="{D2AC2886-B39B-11D1-8704-00600893B1BD}" threadingModel="Both" description="DirectMusicSeqTrack"/>
    <comClass clsid="{D2AC2887-B39B-11D1-8704-00600893B1BD}" threadingModel="Both" description="DirectMusicSysExTrack"/>
    <comClass clsid="{D2AC2888-B39B-11D1-8704-00600893B1BD}" threadingModel="Both" description="DirectMusicTimeSigTrack"/>
    <comClass clsid="{EE0B9CA0-A81E-11D3-9BD1-0080C7150A74}" threadingModel="Both" description="DirectMusicAudioPath"/>
    <comClass clsid="{EED36461-9EA5-11D3-9BD1-0080C7150A74}" threadingModel="Both" description="DirectMusicWaveTrack"/>
  </file>
  <file name="ms_dmloader.dll">
    <comClass clsid="{9301E380-1F22-11D3-8226-D2FA76255D47}" threadingModel="Both" description="DirectMusicContainer"/>
